{
  "$schema": "./node_modules/syncpack/schema.json",
  "indent": "  ",
  "sortAz": [
    "bin",
    "contributors",
    "dependencies",
    "devDependencies",
    "keywords",
    "peerDependencies",
    "resolutions"
  ],
  "sortFirst": [
    "name",
    "version",
    "private",
    "description",
    "author",
    "license",
    "type",
    "main",
    "exports",
    "files",
    "workspaces",
    "scripts",
    "dependencies",
    "devDependencies",
    "peerDependencies"
  ],
  "source": [
    "package.json",
    "apps/*/package.json",
    "packages/*/package.json",
    "packages/oxlint/nestjs/package.json",
    "packages/tsconfig/nestjs/package.json"
  ],
  "semverGroups": [
    {
      "label": "Ignore local workspace package specifiers",
      "dependencies": ["$LOCAL"],
      "dependencyTypes": ["!local"],
      "isIgnored": true
    },
    {
      "label": "Use caret ranges for npm dependencies",
      "range": "^"
    }
  ],
  "versionGroups": [
    {
      "label": "Use 0.0.1 for local workspace packages",
      "dependencies": ["$LOCAL"],
      "dependencyTypes": ["!local"],
      "pinVersion": "0.0.1"
    }
  ]
}
