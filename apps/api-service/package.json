    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "vitest": "^3.2.4"
  }
